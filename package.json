{
  "name": "mockmentor",
  "version": "1.0.0",
  "description": "MockMentor — realistic AI mock interviews tailored to your resume and the job description, on Cloudflare Pages + Workers + D1.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public --compatibility-date=2024-11-01 --d1 DB=mockmentor",
    "db:init:local": "wrangler d1 execute mockmentor --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute mockmentor --remote --file=./schema.sql",
    "deploy": "wrangler pages deploy public"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
